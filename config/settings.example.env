# Copy to repo-root .env:  cp config/settings.example.env .env
DATABASE_URL=file:./data/cointrace.db
ESPLORA_BASE=https://blockstream.info/api
MEMPOOL_BASE=https://mempool.space/api
RATE_LIMIT_MS=8000
JOBS_PER_TICK=1
CRON_INTERVAL_SEC=60
# Fair scheduling enqueue caps (per cron tick)
POLL_HACKER_ENQUEUE_PER_CRON=1
CRAWL_ENQUEUE_PER_CRON=3
DOWNSTREAM_POLL_ENQUEUE_PER_CRON=2
DOWNSTREAM_POLL_INTERVAL_SEC=600
MAX_CRAWL_DEPTH=5
MAX_GRAPH_DEPTH=2
MIN_EDGE_SATS=1000
# ENVIRONMENT=production  # requires CORS_ORIGINS; enables per-IP API rate limits
# (CF prod: pinned in wrangler.toml [env.production.vars]; local Node/cf:dev stay development)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
EXPAND_RATE_LIMIT=5
EXPAND_RATE_WINDOW_SEC=600
EXPAND_MAX_ACTIVE=20
GET_RATE_LIMIT=120
GET_RATE_WINDOW_SEC=60
GRAPH_RATE_LIMIT=30
GRAPH_RATE_WINDOW_SEC=60
MAX_GRAPH_VICTIMS=10000
MAX_GRAPH_DOWNSTREAM=10000
BALANCE_REFRESH_INTERVAL_SEC=300
BTC_USD_PRICE_REFRESH_INTERVAL_SEC=60
COLDCARDWATCH_SYNC_INTERVAL_SEC=3600
COLDCARDWATCH_BASE=https://coldcardwatch.com
MONITORING_STALE_SEC=600
API_THRESHOLD_COOLDOWN_SEC=300
BACKFILL_TXS_PER_JOB=5
BACKFILL_MAX_TXS=10000
BACKFILL_HEAL_AUDIT_INTERVAL_SEC=86400
BACKFILL_HEAL_AUDIT_PER_CRON=1
BACKFILL_HEAL_TX_SLACK=5
INDEXER_REBUILD_MODE=0
PROCESS_TX_REBUILD_PRIORITY=11
VITE_EXPLORER_BASE=https://mempool.space
PORT=8787
