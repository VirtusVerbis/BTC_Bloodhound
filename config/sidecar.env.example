# Remote indexer sidecar defaults (prod D1 via wrangler getPlatformProxy).
# Copy to config/sidecar.env or set DOTENV_CONFIG_PATH before run --remote.
#
# While cron is paused (sidecar drain), prod /api/config serves 1-min hacker dropdown
# poll (hackersPollMs=60000); no sidecar.env var needed. Resume cron for 1-hour poll.
# Chain API pacing (moderate vs prod cron MAX_CHAIN_CALLS_PER_JOB=1)
# 6500ms: conservative step down from 8000; watch apiBackoff in heartbeat before lowering further.
RATE_LIMIT_MS=6500
MAX_CHAIN_CALLS_PER_JOB=5

# Throughput (no extra Esplora calls)
BACKFILL_TXS_PER_JOB=10
JOBS_PER_TICK=3
JOBS_PER_TICK_MAX=3
CRON_INTERVAL_SEC=300

# Tick / CPU (local Node — no CF caps)
TICK_BUDGET_MS=50000
JOB_CPU_GUARD_MS=0
SUBREQUEST_LIMIT_PER_INVOCATION=0

# API 429 backoff (shared in prod D1 scheduler_state)
API_THRESHOLD_BASE_SEC=300
API_THRESHOLD_MAX_SEC=3600

# Console logging (sidecar defaults on; pass --no-job-details / --no-log-color to disable)
# INDEXER_LOG_COLOR_MODE=sidecar: white [sidecar] lines; [job]/[cron] use prod cron label colors.
INDEXER_JOB_DETAILS=1
INDEXER_LOG_COLOR=1
INDEXER_LOG_COLOR_MODE=sidecar
SIDECAR_HEARTBEAT_SEC=30

# D1 row metering (sidecar today UTC — not full account usage; persisted locally)
# D1_WRITE_DAILY_LIMIT=100000
# D1_READ_DAILY_LIMIT=5000000
# D1_WRITE_WARN_PCT=90
# SIDECAR_D1_METER_PATH=data/sidecar-d1-meter.json
